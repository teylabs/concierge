{
    "name": "tey/concierge",
    "description": "A standard suite of essentials for every Laravel app you build.",
    "keywords": [
        "laravel",
        "user-management",
        "invitations",
        "membership",
        "roles",
        "permissions",
        "teams",
        "workspaces",
        "multi-tenancy",
        "local-login",
        "spatie-laravel-permission",
        "starter-kit",
        "inertia",
        "vue"
    ],
    "homepage": "https://concierge.teylabs.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Jasper Tey",
            "email": "jasper@teylabs.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.0||~8.5.0",
        "illuminate/contracts": "^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "tey/mod": "^0.6.1 || ^0.7 || ^0.8 || ^0.9 || ^0.10 || ^0.11"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/fortify": "^1.41",
        "laravel/pint": "^1.27",
        "laravel/sanctum": "^4.3",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Tey\\Concierge\\": "src/",
            "Tey\\Concierge\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tey\\Concierge\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tey\\Concierge\\ConciergeServiceProvider"
            ]
        },
        "tey-standards": {
            "ci": {
                "default-branches": [
                    "main",
                    "*.x"
                ],
                "distribution": "package",
                "drafts": "full",
                "enforce": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
